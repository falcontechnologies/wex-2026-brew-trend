<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>

    <key>Label</key>
    <string>com.brewanalytics.fetch</string>

    <!-- Runs a small shell script so we can chain fetch → archive in one job -->
    <!-- ⚠️  UPDATE ALL PATHS below to match your machine -->
    <key>ProgramArguments</key>
    <array>
        <string>/bin/sh</string>
        <string>-c</string>
        <string>
            /usr/local/bin/python3.11 /Users/sarahye/Downloads/vscodeprojects/wex26/brew_analytics_to_sqlite.py --db /Users/sarahye/Downloads/vscodeprojects/wex26/brew_analytics.db &amp;&amp;
            /usr/local/bin/python3.11 /Users/sarahye/Downloads/vscodeprojects/wex26/brew_archive.py --db /Users/sarahye/Downloads/vscodeprojects/wex26/brew_analytics.db --archive /Users/sarahye/Downloads/vscodeprojects/wex26/brew_analytics_archive.db
        </string>
    </array>

    <!-- Run every day at 9:00 AM -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>9</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/sarahye/Downloads/vscodeprojects/wex26/brew_analytics.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/sarahye/Downloads/vscodeprojects/wex26/brew_analytics_error.log</string>

    <key>RunAtLoad</key>
    <false/>

</dict>
</plist>
